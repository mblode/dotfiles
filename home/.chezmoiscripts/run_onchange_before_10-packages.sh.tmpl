{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
#
# Install Homebrew (if missing) and everything in the Brewfile.
# Re-runs automatically whenever the Brewfile below changes.

set -euo pipefail

if ! command -v brew >/dev/null 2>&1; then
	echo "Installing Homebrew..."
	NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Put brew on PATH for this script (Apple Silicon + Intel).
if [ -x /opt/homebrew/bin/brew ]; then
	eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
	eval "$(/usr/local/bin/brew shellenv)"
fi

brewfile="$(mktemp)"
keepalive=""
cleanup() {
	rm -f "$brewfile"
	if [ -n "$keepalive" ]; then kill "$keepalive" 2>/dev/null || true; fi
}
trap cleanup EXIT

# Ask for the admin password once, up front, so casks that run a .pkg installer
# or replace an app in /Applications don't stop halfway through the bundle.
# Keep the sudo timestamp fresh until this script exits.
if [ -t 0 ] && sudo -v; then
	while kill -0 "$$" 2>/dev/null; do
		sudo -n true
		sleep 50
	done 2>/dev/null &
	keepalive=$!
fi

cat >"$brewfile" <<'BREWFILE'
{{ include "dot_Brewfile" }}
BREWFILE

# Homebrew >= 6 enforces HOMEBREW_REQUIRE_TAP_TRUST, so casks/formulae from
# third-party taps must be trusted before `brew bundle` will load them. Trust
# every non-official tap the Brewfile declares so a fresh Mac bootstraps clean.
while read -r tap; do
	case "$tap" in
	homebrew/*) ;;
	*) brew trust --tap "$tap" >/dev/null 2>&1 || true ;;
	esac
done < <(grep -E '^tap "' "$brewfile" | sed -E 's/^tap "([^"]+)".*/\1/' || true)

echo "Installing packages from Brewfile..."
# A cask can still fail (no password given, a GUI installer, a disabled cask).
# Don't let that abort the whole apply — install everything we can, and the
# next-steps script at the end of the apply lists whatever is missing.
if ! brew bundle --file="$brewfile"; then
	echo "WARNING: some Brewfile entries didn't install; see the next steps at the end." >&2
fi
{{ end -}}
